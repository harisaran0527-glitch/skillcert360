generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
	url = env("DATABASE_URL")
	directUrl = env("DIRECT_URL")
}

enum UserRole {
	ADMIN
	STUDENT
}

enum AccountStatus {
	ACTIVE
	DISABLED
}

enum CertificateStatus {
	LOCKED
	UNLOCKED
	PENDING_SUBMISSION
	SUBMITTED
	PENDING_VERIFICATION
	VERIFIED
	REJECTED
	NEEDS_RESUBMISSION
}

enum QuestionType {
	SINGLE_CHOICE
	MULTIPLE_CHOICE
	TRUE_FALSE
	CODING
	FILL_BLANK
	PRACTICAL
}

enum Difficulty {
	EASY
	MEDIUM
	HARD
}

enum CredentialType {
	NONE
	COMPLETION_CERTIFICATE
	DIGITAL_BADGE
	ACHIEVEMENT
	APPLIED_SKILL
	MICROCREDENTIAL
	PROFESSIONAL_CERTIFICATION
}

enum UrlStatus {
	VERIFIED
	OFFICIAL_LINK_PENDING
	RETIRED
	UNAVAILABLE
}

enum PricingType {
	FREE
	PAID
	FREE_LEARNING_PAID_EXAM
	SUBSCRIPTION
	UNKNOWN
}

model User {
	id String @id @default(cuid())
	email String @unique
	passwordHash String
	role UserRole
	status AccountStatus @default(ACTIVE)
	mustChangePassword Boolean @default(false)
	lastLoginAt DateTime?
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	studentProfile StudentProfile?
	activityLogs ActivityLog[]
	verifiedCertificates Certificate[] @relation("VerifiedBy")
	certificateReviews CertificateReview[]
}

model StudentProfile {
	id String @id @default(cuid())
	userId String @unique
	fullName String
	registerNumber String @unique
	departmentId String
	year Int
	sectionId String
	user User @relation(fields: [userId], references: [id], onDelete: Cascade)
	department Department @relation(fields: [departmentId], references: [id])
	section Section @relation(fields: [sectionId], references: [id])
	skills StudentSkill[]
	attempts AssessmentAttempt[]
	certificates Certificate[]
	violations AssessmentViolation[]
	activities ActivityLog[]
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
}

model Department {
	id String @id @default(cuid())
	name String @unique
	active Boolean @default(true)
	students StudentProfile[]
	sections Section[]
}

model Section {
	id String @id @default(cuid())
	name String
	departmentId String
	department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
	students StudentProfile[]
	@@unique([name, departmentId])
}

model SkillLevel {
	id String @id @default(cuid())
	name String @unique
	order Int @unique

	// Old assessment field - historical safety-kaga retain pannrom
	passMark Int

	// Verified certificate target
	// Beginner = 25, Advanced = 50, Pro = 75, Expert = 100
	certificateTarget Int?

	active Boolean @default(true)

	skills Skill[]
	courses Course[]
	questions Question[]
}
model SkillCategory {
	id String @id @default(cuid())
	name String @unique
	slug String @unique
	active Boolean @default(true)
	skills Skill[]
}

model Skill {
	id String @id @default(cuid())
	name String
	slug String @unique
	description String?
	icon String?
	active Boolean @default(true)

	categoryId String
	levelId String

	category SkillCategory @relation(fields: [categoryId], references: [id])
	level SkillLevel @relation(fields: [levelId], references: [id])

	courses Course[]
	questions Question[]
	studentSkills StudentSkill[]

	prerequisites SkillPrerequisite[] @relation("SkillPrerequisiteTarget")
	requiredFor SkillPrerequisite[] @relation("SkillPrerequisiteSource")

	certificates Certificate[]

	// New Smart Skill Guide topics
	topics SkillTopic[]

	// Old assessment relations retained temporarily for existing data safety
	assessmentConfig AssessmentConfig?
	attempts AssessmentAttempt[]

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([active, levelId, name])
	@@index([categoryId, active])
}
model SkillPrerequisite {
	skillId String
	prerequisiteId String
	skill Skill @relation("SkillPrerequisiteTarget", fields: [skillId], references: [id], onDelete: Cascade)
	prerequisite Skill @relation("SkillPrerequisiteSource", fields: [prerequisiteId], references: [id], onDelete: Cascade)
	@@id([skillId, prerequisiteId])
}

model Provider {
	id String @id @default(cuid())
	name String @unique
	slug String? @unique
	officialWebsite String?
	website String?
	logo String?
	description String?
	active Boolean @default(true)
	courses Course[]
	certificates Certificate[]
}

model Course {
	id String @id @default(cuid())
	skillId String
	providerId String
	levelId String

	name String
	title String?
	officialUrl String
	officialUrlStatus UrlStatus @default(OFFICIAL_LINK_PENDING)

	durationMinutes Int?
	duration String?

	isFree Boolean @default(true)
	pricingType PricingType @default(FREE)

	certificateAvailable Boolean @default(false)
	credentialAvailable Boolean @default(false)
	credentialType CredentialType @default(NONE)
	credentialUrl String?

	description String?
	prerequisites String?
	learningOutcomes Json?

	active Boolean @default(true)
	verifiedAt DateTime?

	progress CourseProgress[]
	selectedByStudentSkills StudentSkill[] @relation("SelectedCourse")
	certificates Certificate[]
	questions Question[]

	// New Smart Skill Guide mapping
	topicMappings CourseTopic[]

	skill Skill @relation(fields: [skillId], references: [id])
	provider Provider @relation(fields: [providerId], references: [id])
	level SkillLevel @relation(fields: [levelId], references: [id])

	createdAt DateTime @default(now())

	@@index([skillId, active, providerId])
	@@index([providerId, active])
	@@index([active, name])
}
model StudentSkill {
	id String @id @default(cuid())
	studentId String
	skillId String
	selectedCourseId String?
	startedAt DateTime @default(now())
	completedAt DateTime?
	verifiedAt DateTime?
	state String @default("LEARNING")
	courseProgress CourseProgress[]
	selectedCourse Course? @relation("SelectedCourse", fields: [selectedCourseId], references: [id], onDelete: SetNull)
	student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
	skill Skill @relation(fields: [skillId], references: [id])
	@@unique([studentId, skillId])
	@@index([selectedCourseId])
	@@index([studentId, state])
}

model Question {
	id String @id @default(cuid())
	skillId String
	courseId String?
	levelId String
	type QuestionType
	difficulty Difficulty
	prompt String
	options Json?
	correctAnswer Json
	explanation String?
	active Boolean @default(true)
	skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
	course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
	level SkillLevel @relation(fields: [levelId], references: [id])
	answers AssessmentAnswer[]
	@@index([courseId, active])
	@@index([skillId, active])
}

model AssessmentConfig {
	id String @id @default(cuid())
	skillId String @unique
	questionCount Int @default(50)
	durationMinutes Int @default(45)
	violationLimit Int @default(3)
	cooldownHours Int @default(6)
	active Boolean @default(true)
	skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model AssessmentAttempt {
	id String @id @default(cuid())
	token String @unique
	studentId String
	skillId String
	startedAt DateTime @default(now())
	expiresAt DateTime
	submittedAt DateTime?
	score Int?
	passed Boolean?
	terminated Boolean @default(false)
	attemptNumber Int @default(1)
	questionCount Int @default(50)
	passMark Int @default(30)
	violationLimit Int @default(3)
	cooldownHours Float @default(6)
	autoSubmitOnViolation Boolean @default(true)
	certificateRequired Boolean @default(true)
	autoSubmitted Boolean @default(false)
	submissionReason String?
	reexamAvailableAt DateTime?
	clientId String?
	clientLeaseUntil DateTime?
	skill Skill @relation(fields: [skillId], references: [id])
	student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
	answers AssessmentAnswer[]
	violations AssessmentViolation[]
	@@index([studentId, submittedAt])
	@@index([studentId, skillId, submittedAt])
	@@index([submittedAt, expiresAt, terminated])
}

model AssessmentAnswer {
	id String @id @default(cuid())
	attemptId String
	questionId String
	answer Json
	answeredAt DateTime @default(now())
	position Int @default(0)
	questionSnapshot Json?
	correctAnswerSnapshot Json?
	attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
	question Question @relation(fields: [questionId], references: [id])
	@@unique([attemptId, questionId])
}

model AssessmentViolation {
	id String @id @default(cuid())
	attemptId String
	studentId String
	type String
	occurredAt DateTime @default(now())
	metadata Json?
	attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
	student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Certificate {
	id String @id @default(cuid())
	certificateNumber String? @unique
	studentId String
	skillId String
	courseId String?
	providerId String?
	status CertificateStatus @default(PENDING_VERIFICATION)
	credentialType CredentialType @default(NONE)
	credentialName String?
	certificateTitle String?
	credentialUrl String?
	issueDate DateTime?
	expiryDate DateTime?
	officialUrl String?
	credentialId String?
	filePath String?
	originalFileName String?
	mimeType String?
	fileSize Int?
	fileHash String?
	uploadedAt DateTime?
	storageProvider String?
	remarks String?
	rejectionReason String?
	verifiedById String?
	submittedAt DateTime?
	verifiedAt DateTime?
	issuedAt DateTime?
	createdAt DateTime @default(now())
	updatedAt DateTime @default(now()) @updatedAt
	reviews CertificateReview[]
	student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
	skill Skill @relation(fields: [skillId], references: [id])
	course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
	provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
	verifiedBy User? @relation("VerifiedBy", fields: [verifiedById], references: [id])
	@@index([studentId, skillId])
	@@index([studentId, status])
	@@index([status])
}

model ActivityLog {
	id String @id @default(cuid())
	userId String?
	studentId String?
	action String
	metadata Json?
	createdAt DateTime @default(now())
	user User? @relation(fields: [userId], references: [id])
	student StudentProfile? @relation(fields: [studentId], references: [id])
	@@index([studentId, createdAt])
	@@index([userId, createdAt])
	@@index([action, createdAt])
}

model AdminSetting {
	key String @id
	value Json
	updatedAt DateTime @updatedAt
}

model CourseProgress {
	id String @id @default(cuid())
	studentSkillId String
	courseId String
	startedAt DateTime @default(now())
	completedAt DateTime?
	studentSkill StudentSkill @relation(fields: [studentSkillId], references: [id], onDelete: Cascade)
	course Course @relation(fields: [courseId], references: [id])
	@@unique([studentSkillId, courseId])
}

model CertificateReview {
	id String @id @default(cuid())
	certificateId String
	actorId String
	status CertificateStatus
	remarks String?
	officialUrl String?
	credentialId String?
	filePath String?
	originalFileName String?
	mimeType String?
	fileSize Int?
	issuedAt DateTime?
	createdAt DateTime @default(now())
	certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
	actor User @relation(fields: [actorId], references: [id])
}
model SkillTopic {
	id String @id @default(cuid())
	skillId String

	name String
	slug String
	description String?
	order Int @default(0)
	active Boolean @default(true)

	skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

	courseMappings CourseTopic[]

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@unique([skillId, slug])
	@@index([skillId, active, order])
}
model CourseTopic {
	courseId String
	topicId String

	course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
	topic SkillTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

	@@id([courseId, topicId])
	@@index([topicId])
}